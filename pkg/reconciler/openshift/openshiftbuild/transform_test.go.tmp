package openshiftbuild

import (
	"testing"

	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
)

func TestRemoveRunAsUserRunAsGroup(t *testing.T) {
	deployment := &unstructured.Unstructured{Object: map[string]interface{}{
		"apiVersion": "apps/v1",
		"kind":       "Deployment",
		"metadata":   map[string]interface{}{"name": "shp-build-controller"},
		"spec": map[string]interface{}{
			"template": map[string]interface{}{
				"spec": map[string]interface{}{
					"securityContext": map[string]interface{}{
						"runAsUser":    int64(1000),
						"runAsGroup":   int64(1000),
						"runAsNonRoot": true,
					},
					"containers": []interface{}{
						map[string]interface{}{
							"name": "manager",
							"securityContext": map[string]interface{}{
								"runAsUser":  int64(65532),
								"runAsGroup": int64(65532),
							},
						},
					},
				},
			},
		},
	}}

	if err := removeRunAsUserRunAsGroup(deployment); err != nil {
		t.Fatalf("removeRunAsUserRunAsGroup() returned error: %v", err)
	}

	podSC, _, _ := unstructured.NestedMap(deployment.Object, "spec", "template", "spec", "securityContext")
	if _, ok := podSC["runAsUser"]; ok {
		t.Error("expected pod-level runAsUser to be removed")
	}
	if _, ok := podSC["runAsGroup"]; ok {
		t.Error("expected pod-level runAsGroup to be removed")
	}
	// unrelated fields must be preserved
	if _, ok := podSC["runAsNonRoot"]; !ok {
		t.Error("expected pod-level runAsNonRoot to be preserved")
	}

	containers, _, _ := unstructured.NestedSlice(deployment.Object, "spec", "template", "spec", "containers")
	containerSC, _ := containers[0].(map[string]interface{})["securityContext"].(map[string]interface{})
	if _, ok := containerSC["runAsUser"]; ok {
		t.Error("expected container-level runAsUser to be removed")
	}
	if _, ok := containerSC["runAsGroup"]; ok {
		t.Error("expected container-level runAsGroup to be removed")
	}
}

func TestRemoveRunAsUserRunAsGroupIgnoresOtherKinds(t *testing.T) {
	cm := &unstructured.Unstructured{Object: map[string]interface{}{
		"apiVersion": "v1",
		"kind":       "ConfigMap",
		"metadata":   map[string]interface{}{"name": "config"},
	}}
	if err := removeRunAsUserRunAsGroup(cm); err != nil {
		t.Fatalf("removeRunAsUserRunAsGroup() returned error for ConfigMap: %v", err)
	}
}
